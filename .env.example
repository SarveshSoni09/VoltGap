# Copy to .env and fill in. All keys are free tier. .env is gitignored.

# developer.nlr.gov  -- AFDC stations, charging units
# NOTE: developer.nrel.gov was retired on 29 May 2026 and no longer resolves.
# DEMO_KEY works but is limited to 10 requests per window; a personal key allows 1,000/hr.
NREL_API_KEY=

# api.census.gov/data/key_signup.html  -- ACS
# Optional for the pipeline: the keyless bulk summary file is the primary route. The API
# itself does require a key - a keyless request returns HTTP 200 with an HTML error page.
CENSUS_API_KEY=

# huduser.gov/portal/dataset/uspszip-api.html  -- USPS ZIP Code Crosswalk
# Select the USPS ZIP CODE CROSSWALK dataset. Sent as an Authorization: Bearer header.
# Without it the pipeline falls back to land-area allocation, a documented degraded mode.
HUD_USER_TOKEN=

# eia.gov/opendata/register.php  -- state electricity and fuel prices
EIA_API_KEY=

# Not needed until Phase 6
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
