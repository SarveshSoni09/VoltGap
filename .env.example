# api.census.gov/data/key_signup.html  -- ACS (optional, bulk download works without)
CENSUS_API_KEY=

# eia.gov/opendata/register.php  -- state electricity and fuel prices
EIA_API_KEY=

# Not needed until Phase 6
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
