        <th id="HEV">Hybrid Electric (HEV)</th>
        <th id="Biodiesel">Biodiesel</th>
        <th id="Flex">Ethanol/Flex (E85)</th>
        <th id="CNG">Compressed Natural Gas (CNG)</th>
        <th id="Propane">Propane</th>
        <th id="Hydrogen">Hydrogen</th>
        <th id="Methanol">Methanol</th>
        <th id="Gas">Gasoline</th>
        <th id="Diesel">Diesel</th>
        <th id="Unknown">Unknown Fuel</th>
    </tr>
  </thead>
